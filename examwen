 // ejercicio91: rellenar la matriz con los números 1..n*n en espiral (horario) desde (0,0)
    ejercicio91(){
      const total = this.rows * this.cols;
      let value = 1;

      for (let i = 0; i < this.rows; i++){
        for (let j = 0; j < this.cols; j++){
          this.data[i][j] = 0;
        }
      }
      let arriba = 0, bottom = this.rows - 1, left = 0, right = this.cols - 1;
      while (value <= total){
        for (let j = left; j <= right && value <= total; j++){
          this.data[arriba][j] = value++;
        }
        arriba++;

        
        for (let i = arriba; i <= bottom && value <= total; i++){
          this.data[i][right] = value++;
        }
        right--;

     
        for (let j = right; j >= left && value <= total; j--){
          this.data[bottom][j] = value++;
        }
        bottom--;

        for (let i = bottom; i >= arriba && value <= total; i--){
          this.data[i][left] = value++;
        }
        left++;
      }
    }

    
