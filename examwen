  ejercicio95(){
    // Rellenar la matriz en "serpiente diagonal" (zigzag por diagonales)
    // Recorremos diagonales con suma de índices s = row + col.
    // Para cada diagonal recogemos coordenadas y las recorremos en orden alternado.
    let value = 1;
    // inicializar
    

    const maxS = 18;
    for (let s = 0; s <= maxS; s++){
      const coords = [];
      for (let r = 0; r < this.rows; r++){
        const c = s - r;
        if (c >= 0 && c < this.cols){
          coords.push([r, c]);
        }
      }
     
      if (s % 2 === 0) coords.reverse();
      for (const [r, c] of coords){
        this.data[r][c] = value++;
      }
    }
  }
